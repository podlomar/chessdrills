---
import styles from './HomePage.module.css';
import '../styles/global.css';
import { twoKingsAndPawn } from '../chessboard/generate.js';
import { twoKingsAndQueen } from '../generators/twoKingsAndQueen.js';
import { TrainingBoard } from '../components/TrainingBoard.js';

const pawnFen = twoKingsAndPawn();
const queenFen = twoKingsAndQueen();
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Chess Train</title>
  </head>
  <body>
    <div class={styles.container}>
      <h1>Chess Train</h1>
      <div class={styles.boards}>
        <TrainingBoard
          client:load
          type="twoKingsAndPawn"
          title="Two Kings and Pawn"
          initialFen={pawnFen}
        />
        <TrainingBoard
          client:load
          type="twoKingsAndQueen"
          title="Two Kings and Queen"
          initialFen={queenFen}
        />
      </div>
    </div>
  </body>
</html>
