---
import Base from '../layouts/Base.astro';
import styles from './HomePage.module.css';

const categories = [
  {
    slug: 'endgame-fundamentals',
    title: 'Endgame Fundamentals',
    desc: 'Master essential endgame techniques with king and piece coordination.',
    count: 3,
  },
  {
    slug: 'openings',
    title: 'Openings',
    desc: 'Study common opening patterns and traps from both sides.',
    count: 0,
  },
];
---

<Base title="Chess Drills">
  <main class={styles.main}>
    <div class={styles.hero}>
      <p class={styles.tagline}>Practice positions. Build intuition.</p>
    </div>
    <div class={styles.categories}>
      {categories.map((cat) => (
        <a href={`/${cat.slug}`} class={styles.card}>
          <div class={styles.cardBody}>
            <h2 class={styles.cardTitle}>{cat.title}</h2>
            <p class={styles.cardDesc}>{cat.desc}</p>
          </div>
          <div class={styles.cardFooter}>
            <span class={styles.drillCount}>
              {cat.count > 0 ? `${cat.count} drills` : 'Coming soon'}
            </span>
            <span class={styles.arrow}>→</span>
          </div>
        </a>
      ))}
    </div>
  </main>
</Base>
